{{!
    @template theme_cpi/ads_item

    Un anuncio: <picture> con la imagen móvil (si existe) bajo 768px; enlace opcional
    en pestaña nueva, marcado como patrocinado.

    Example context (json):
    {
        "image": "https://example.com/a.png", "imagemobile": "", "hasmobile": false,
        "url": "https://example.com", "haslink": true, "alt": "Anuncio de prueba"
    }
}}
{{#haslink}}<a class="cpi-ad-link" href="{{url}}" target="_blank" rel="noopener sponsored">{{/haslink}}
<picture>
    {{#hasmobile}}<source media="(max-width: 767.98px)" srcset="{{imagemobile}}">{{/hasmobile}}
    <img class="cpi-ad-img" src="{{image}}" alt="{{alt}}" loading="lazy">
</picture>
{{#haslink}}</a>{{/haslink}}
