{{!
    @template theme_cpi/ads

    Anuncios del dashboard (\theme_cpi\local\ads). 1 anuncio: imagen fija.
    2 o más: carrusel de Bootstrap 5 (6 s, puntos, pausa al pasar el mouse).

    Context variables required for this template:
    * id, multiple
    * ads: [{index, number, first, image, imagemobile, hasmobile, url, haslink, alt}]

    Example context (json):
    {
        "id": "cpiads1",
        "multiple": false,
        "ads": [{"index": 0, "number": 1, "first": true, "image": "https://example.com/a.png",
                 "imagemobile": "", "hasmobile": false, "url": "https://example.com",
                 "haslink": true, "alt": "Anuncio de prueba"}]
    }
}}
<section class="cpi-ads" aria-label="{{#str}}ads_region, theme_cpi{{/str}}">
    <span class="cpi-ads-label">{{#str}}ad_label, theme_cpi{{/str}}</span>
    {{#multiple}}
        <div id="{{id}}" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000" data-bs-pause="hover">
            <div class="carousel-indicators">
                {{#ads}}
                    <button type="button" data-bs-target="#{{id}}" data-bs-slide-to="{{index}}"
                        {{#first}}class="active" aria-current="true"{{/first}}
                        aria-label="{{#str}}ad_slide, theme_cpi, {{number}}{{/str}}"></button>
                {{/ads}}
            </div>
            <div class="carousel-inner">
                {{#ads}}
                    <div class="carousel-item{{#first}} active{{/first}}">
                        {{> theme_cpi/ads_item }}
                    </div>
                {{/ads}}
            </div>
        </div>
    {{/multiple}}
    {{^multiple}}
        {{#ads}}
            {{> theme_cpi/ads_item }}
        {{/ads}}
    {{/multiple}}
</section>
