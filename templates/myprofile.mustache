{{!
    @template theme_cpi/myprofile

    Perfil v2 estilo welearning (perfil-welearning.md §10 + rediseño 2026-10).

    Escritorio (≥992px): izquierda "Acerca de mi" (banda navy con avatar encimado) +
    "Accesos"; derecha "Cursos" + "Mi inmobiliaria" + "Más". Móvil: una columna en el
    orden Acerca de mi, Cursos, Mi inmobiliaria, Accesos, Más (las columnas pasan a
    display: contents y cada tarjeta lleva su order en post.scss).

    Context variables required for this template:
    * fullname, email, showemail, avatar, description, hasdescription
    * canedit, editurl, canmessage, messageurl, messageattrs
    * escuela/personal: [{icon, label, value, empty}], redes: [{icon, title, haslink, url}]
    * accesos: [{icon, label, value}], isownprofile
    * courses: [{name, url, haslink, category, teachers, hasteachers}], hascourses, showcourses
    * inmo: {has, rows, comparte, inventario, hasinventario, whatsapp, haswhatsapp, hasbuttons, isown, editurl}
    * hasmore, more

    Example context (json):
    {
        "fullname": "Alumno Prueba",
        "email": "alumno@example.com",
        "showemail": true,
        "avatar": "<img src='#' alt=''>",
        "hasdescription": false,
        "canedit": true,
        "editurl": "/user/edit.php?id=3",
        "canmessage": false,
        "hasescuela": true,
        "escuela": [{"icon": "fa-school", "label": "Nivel", "value": "Licenciatura", "empty": false}],
        "haspersonal": false,
        "hasredes": false,
        "accesos": [{"icon": "fa-calendar", "label": "Activo desde", "value": "3-Oct-2026 05:02 pm"}],
        "isownprofile": true,
        "showcourses": true,
        "hascourses": false,
        "inmo": {"has": false, "isown": true, "editurl": "/user/edit.php?id=3"},
        "hasmore": false
    }
}}
<div class="cpi-profile">
    <div class="cpi-profile-grid">

        {{! ---------- Columna izquierda ---------- }}
        <div class="cpi-profile-col cpi-profile-col-left">

            <section class="cpi-card cpi-card-about">
                <div class="cpi-profile-band">
                    {{#canedit}}
                        <a class="cpi-band-gear" href="{{editurl}}" title="{{#str}}editmyprofile{{/str}}">
                            <i class="fas fa-cog" aria-hidden="true"></i>
                            <span class="visually-hidden">{{#str}}editmyprofile{{/str}}</span>
                        </a>
                    {{/canedit}}
                </div>
                <h3 class="visually-hidden">Acerca de mi</h3>

                <div class="cpi-profile-identity">
                    <div class="cpi-profile-avatar">{{{avatar}}}</div>
                    <p class="cpi-profile-name">{{fullname}}</p>
                    {{#showemail}}<p class="cpi-profile-email">{{email}}</p>{{/showemail}}
                    {{#canmessage}}
                        <a id="cpi-message-user-button" role="button" class="btn btn-sm btn-outline-primary cpi-profile-message"
                            href="{{messageurl}}" {{#messageattrs}}{{name}}="{{value}}" {{/messageattrs}}>
                            <i class="fas fa-comment" aria-hidden="true"></i>
                            {{#str}}message, message{{/str}}
                        </a>
                    {{/canmessage}}
                    {{#hasdescription}}<div class="cpi-profile-desc">{{{description}}}</div>{{/hasdescription}}
                </div>

                {{#hasescuela}}
                    <h4 class="cpi-section-title">Escuela</h4>
                    <ul class="cpi-rows">
                        {{#escuela}}{{> theme_cpi/myprofile_row }}{{/escuela}}
                    </ul>
                {{/hasescuela}}

                {{#haspersonal}}
                    <h4 class="cpi-section-title">Personal</h4>
                    <ul class="cpi-rows">
                        {{#personal}}{{> theme_cpi/myprofile_row }}{{/personal}}
                    </ul>
                {{/haspersonal}}

                {{#hasredes}}
                    <h4 class="cpi-section-title">Redes Sociales</h4>
                    <p class="cpi-socials">
                        {{#redes}}
                            {{#haslink}}
                                <a href="{{url}}" target="_blank" rel="noopener" class="cpi-social cpi-social-on" title="{{title}}">
                                    <i class="fab {{icon}}" aria-hidden="true"></i>
                                    <span class="visually-hidden">{{title}}</span>
                                </a>
                            {{/haslink}}
                            {{^haslink}}
                                <span class="cpi-social cpi-social-off">
                                    <i class="fab {{icon}}" aria-hidden="true"></i>
                                    <span class="visually-hidden">{{title}}: sin capturar</span>
                                </span>
                            {{/haslink}}
                        {{/redes}}
                    </p>
                {{/hasredes}}
            </section>

            <section class="cpi-card cpi-card-accesos">
                <div class="cpi-card-head">
                    <h3 class="cpi-card-title">Accesos</h3>
                </div>
                <ul class="cpi-rows">
                    {{#accesos}}
                        <li class="cpi-row">
                            <div class="cpi-row-label">
                                <i class="fas {{icon}} cpi-row-icon" aria-hidden="true"></i>
                                <span>{{label}}</span>
                            </div>
                            <p class="cpi-row-value cpi-nowrap">{{value}}</p>
                        </li>
                    {{/accesos}}
                </ul>
            </section>
        </div>

        {{! ---------- Columna derecha ---------- }}
        <div class="cpi-profile-col cpi-profile-col-right">

            {{#showcourses}}
                <section class="cpi-card cpi-card-courses">
                    <div class="cpi-card-head">
                        <h3 class="cpi-card-title">Cursos</h3>
                    </div>
                    {{#hascourses}}
                        <div class="cpi-table-wrap">
                            <table class="cpi-courses">
                                <thead>
                                    <tr>
                                        <th scope="col">Nombre del curso</th>
                                        <th scope="col">Categoría</th>
                                        <th scope="col">Profesor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#courses}}
                                        <tr>
                                            <td>{{#haslink}}<a href="{{url}}">{{name}}</a>{{/haslink}}{{^haslink}}{{name}}{{/haslink}}</td>
                                            <td>{{category}}</td>
                                            {{#hasteachers}}<td>{{teachers}}</td>{{/hasteachers}}
                                            {{^hasteachers}}<td class="cpi-empty">Sin profesores</td>{{/hasteachers}}
                                        </tr>
                                    {{/courses}}
                                </tbody>
                            </table>
                        </div>
                    {{/hascourses}}
                    {{^hascourses}}
                        <p class="cpi-help-text">Sin cursos inscritos.</p>
                    {{/hascourses}}
                </section>
            {{/showcourses}}

            {{#inmo}}
                <section class="cpi-card cpi-card-inmo">
                    <div class="cpi-card-head">
                        <h3 class="cpi-card-title">Mi inmobiliaria</h3>
                        {{#comparte}}<span class="cpi-badge-gold"><i class="fas fa-handshake" aria-hidden="true"></i> Comparte comisión</span>{{/comparte}}
                    </div>
                    {{#has}}
                        {{#rows.0}}
                            <ul class="cpi-rows">
                                {{#rows}}{{> theme_cpi/myprofile_row }}{{/rows}}
                            </ul>
                        {{/rows.0}}
                        {{#hasbuttons}}
                            <p class="cpi-inmo-actions">
                                {{#hasinventario}}
                                    <a class="btn btn-sm btn-primary" href="{{inventario}}" target="_blank" rel="noopener">
                                        <i class="fas fa-external-link-alt" aria-hidden="true"></i> Ver inventario
                                    </a>
                                {{/hasinventario}}
                                {{#haswhatsapp}}
                                    <a class="btn btn-sm btn-outline-primary" href="{{whatsapp}}" target="_blank" rel="noopener">
                                        <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
                                    </a>
                                {{/haswhatsapp}}
                            </p>
                        {{/hasbuttons}}
                    {{/has}}
                    {{^has}}
                        {{#isown}}
                            <p class="cpi-help-text">
                                <a href="{{editurl}}">Completa los datos de tu inmobiliaria</a> para que otros asesores te encuentren.
                            </p>
                        {{/isown}}
                        {{^isown}}
                            <p class="cpi-help-text">Sin información de inmobiliaria</p>
                        {{/isown}}
                    {{/has}}
                </section>
            {{/inmo}}

            {{! Perfil estándar completo (informes, sesiones, insignias…): se conserva
                colapsado para no perder nada de lo que trae Moodle. Solo para el propio
                usuario y para quien tiene user:viewalldetails. }}
            {{#hasmore}}
                <details class="cpi-card cpi-profile-more">
                    <summary class="cpi-card-title">Más</summary>
                    <div class="cpi-profile-more-body">{{{more}}}</div>
                </details>
            {{/hasmore}}
        </div>
    </div>
</div>
