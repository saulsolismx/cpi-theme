{{!
    @template theme_cpi/myprofile_row

    Fila de datos del perfil: icono navy, etiqueta y valor; vacío en gris.

    Example context (json):
    {"icon": "fa-school", "label": "Nivel", "value": "Licenciatura", "empty": false}
}}
<li class="cpi-row">
    <div class="cpi-row-label">
        <i class="fas {{icon}} cpi-row-icon" aria-hidden="true"></i>
        <span>{{label}}</span>
    </div>
    <p class="cpi-row-value {{#empty}}cpi-empty{{/empty}}">{{{value}}}</p>
</li>
